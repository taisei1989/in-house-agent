      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択…"
          }
        }
      }
    },
    "Cloud providers are not configured. All inference runs locally.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドは未設定です。すべての推論をこのMacで実行します。"
          }
        }
      }
    },
    "Complete setup before registering a routine.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルーティンを登録する前に、セットアップを完了してください。"
