    },
    "Complete setup before starting the server.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セットアップを完了してからサーバーを起動してください。"
          }
        }
      }
    },
    "Create a Python environment and download Gemma to this Mac. The model requires a large download and is stored separately from the application.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Python環境を作成し、このMacにGemmaをダウンロードします。モデルのダウンロードには大容量の通信が必要です。モデルはアプリとは別に保存されます。"
          }
        }
      }
    },
